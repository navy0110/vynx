# Server-only Supabase project settings. No Supabase variables are bundled for the browser.
# The anon key is for server-side auth and anonymous-access tests; never use a secret key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only secret. Never rename this with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Solana devnet only. The treasury must be a valid devnet wallet public key.
NEXT_PUBLIC_TREASURY_WALLET=your-devnet-solana-treasury-wallet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Public application origin (no trailing slash) UPDATE IN HOSTING
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: leave empty to connect with the Phantom browser extension.
# Set a real Portal App ID only for Google/Apple embedded wallet login.
NEXT_PUBLIC_PHANTOM_APP_ID=
