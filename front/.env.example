# Required Supabase project settings. The public key must be the anon/publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-supabase-anon-key

# Server-only secret. Never rename this with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Solana devnet only. The treasury must be a valid devnet wallet public key.
NEXT_PUBLIC_TREASURY_WALLET=your-devnet-solana-treasury-wallet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Public application origin (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required Phantom Portal application ID.
NEXT_PUBLIC_PHANTOM_APP_ID=your-phantom-portal-app-id
