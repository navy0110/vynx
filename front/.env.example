# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Solana configuration
NEXT_PUBLIC_TREASURY_WALLET=your-solana-treasury-wallet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Public application origin (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: enables Google and Apple login through Phantom embedded wallets
NEXT_PUBLIC_PHANTOM_APP_ID=your-phantom-portal-app-id
